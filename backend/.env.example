# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/auctionx

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Email — Brevo API is the primary channel
# Get an API key from Brevo dashboard -> Settings -> SMTP & API -> API Keys
BREVO_API_KEY=
# Optional: override the Brevo sender (defaults to MAIL_FROM below)
# BREVO_SENDER_EMAIL=no-reply@example.com
# BREVO_SENDER_NAME=AuctionXI

# Email — SMTP fallback (used when Brevo is not configured or fails)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-login
SMTP_PASS=your-smtp-password
# SMTP_FAMILY=4

# Sender address for all emails, format: Name <email> or a bare email
MAIL_FROM=AuctionXI <no-reply@example.com>
